---
// The current version's own benchmark suite, as a table.
import type { SuiteResult } from '../data/benchmarks';

interface Props {
	rows: SuiteResult[];
}

const { rows } = Astro.props;
const ns = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(2)} µs` : `${n.toFixed(1)} ns`);
---

<div class="suite">
	<table>
		<thead>
			<tr>
				<th scope="col">Benchmark</th>
				<th scope="col">Time</th>
				<th scope="col">Memory</th>
				<th scope="col">Allocations</th>
			</tr>
		</thead>
		<tbody>
			{
				rows.map((r) => (
					<tr>
						<th scope="row">
							<code>{r.benchmark}</code>
							<span class="suite-what">{r.what}</span>
						</th>
						<td>{ns(r.ns)}</td>
						<td>{r.bytes} B</td>
						<td>{r.allocs}</td>
					</tr>
				))
			}
		</tbody>
	</table>
</div>

<style>
	/* The table scrolls inside its own box on narrow screens instead of widening the page. */
	.suite {
		overflow-x: auto;
	}

	table {
		display: table;
		width: 100%;
	}

	td {
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.suite-what {
		display: block;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
		font-weight: 400;
	}
</style>
